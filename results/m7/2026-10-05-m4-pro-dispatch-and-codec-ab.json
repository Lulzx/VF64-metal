  "host_conditions": "load average 18 from unrelated processes, including one using about seven CPU cores and a JAX job; absolute times are not a baseline and do not replace the 2026-08-29 artifacts",
  "changes": {
    "device_selected_cg": "chunked command buffers stop submission once a finished chunk carries the device-written convergence word; matrix decoded once; r, p, Ap kept as decoded shadows; alpha, convergence, and beta folded into the final reduction stages",
    "device_selected_gmres": "chunked per-column submission with the same stop rule; matrix and Krylov basis kept as decoded shadows; one assembly dispatch over the device-selected columns",
    "nbody_force": "one SIMD group per body; per-pair terms evaluated in parallel; lanes 0-2 accumulate x, y, z in source order",
    "long_row_spmv": "reduced modes use one SIMD group per row with coalesced lane-strided reads and a butterfly reduction when rows average at least 64 nonzeros; ieee64 keeps the sequential row kernel"
  },
  "bitwise_checks": {
    "device_selected_cg": "solution bits, device-selected iteration, and converged residual bits equal the previous fused kernels",
    "device_selected_gmres": "solution bits, device-selected iteration, and residual-estimate bits equal the previous fused kernels",
    "nbody_force": "fp32, fast48, wide48, and ieee64 outputs equal the previous one-thread-per-body kernels",
    "long_row_spmv": "not bitwise: summation order changes in reduced modes; fast48 GEMV p01 accuracy rose from 40.66 to 45.00 bits"
  },
