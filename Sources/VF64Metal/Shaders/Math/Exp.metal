    soft_wide{0xc4742fe35272cd1cul, 0x790285d3580a4a33ul, -88, false},  // 1/26!
    soft_wide{0xe8d58e16e6751905ul, 0x4d0c78aea13b9a50ul, -93, false},  // 1/27!
    soft_wide{0x850c5131a842e9b9ul, 0xe2e28e1aa546a152ul, -97, false},  // 1/28!
    soft_wide{0x92cfcc5a1ac56bd5ul, 0xf1873bb378948eb3ul, -102, false},  // 1/29!
    soft_wide{0x9c9962823eb07306ul, 0x56f6a614c4e2ba58ul, -107, false},  // 1/30!
