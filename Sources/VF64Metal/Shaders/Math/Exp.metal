// truncated Taylor tail at |r| <= ln2/2: < 2^-160.1

// Reduction and Horner evaluation for the main path: finite arguments with
// 2^-60 <= |x| < 1024. Every special case is decided before this is reached.
inline soft_wide soft_exp64_wide(ulong a) {
    soft_wide x = soft_wide_from_f64(a);
    int k = soft_wide_round_to_int(soft_wide_mul(x, SOFT_EXP_INV_LN2));
    soft_wide scaled = soft_wide_from_int(k);
    soft_wide r = soft_wide_sub(x, soft_wide_mul(scaled, SOFT_EXP_LN2_HI));
    r = soft_wide_sub(r, soft_wide_mul(scaled, SOFT_EXP_LN2_LO));

    soft_wide accumulator = SOFT_EXP_RECIPROCAL_FACTORIAL[SOFT_EXP_TERMS];
    for (int term = SOFT_EXP_TERMS - 1; term >= 0; --term) {
        accumulator = soft_wide_add(
            SOFT_EXP_RECIPROCAL_FACTORIAL[term], soft_wide_mul(r, accumulator)
        );
    }
    return soft_wide_scale2(accumulator, k);
}

// |x| < 2^-60 is handled in closed form. There exp(x) lies strictly between
// 1 - 2^-59 and 1 + 2^-59 and is never exactly 1 for x != 0 (Lindemann), so
// the result is 1 or its neighbour, decided by the rounding mode and sign.
// The binary64 neighbours of 1 are 2^-53 below and 2^-52 above, both far
// outside that interval, so no other value is reachable.
constant uint soft_exp_tiny_exponent_field = 963u;  // 1023 - 60

inline ulong soft_exp64_certified(
    ulong a, uint roundingMode, thread uint &flags, thread bool &certified
) {
    certified = true;
    uint exponentField = uint((a >> 52) & 0x7fful);
    ulong fraction = a & 0x000ffffffffffffful;
    bool sign = (a >> 63) != 0ul;

    if (exponentField == 0x7ffu) {
        if (fraction != 0ul) {
            if (soft_is_signaling_nan(a)) flags |= soft_flag_invalid;
            return soft_propagate_nan(a, a);
        }
        return sign ? 0ul : 0x7ff0000000000000ul;
    }
    if (exponentField == 0u && fraction == 0ul) return 0x3ff0000000000000ul;

    if (exponentField < soft_exp_tiny_exponent_field) {
        flags |= soft_flag_inexact;
        bool above = !sign;
        if (roundingMode == soft_round_near_even ||
            roundingMode == soft_round_near_max_mag) {
            return 0x3ff0000000000000ul;
        }
        if (roundingMode == soft_round_max) {
            return above ? 0x3ff0000000000001ul : 0x3ff0000000000000ul;
        }
        // Toward zero and toward negative infinity agree on a positive result.
        return above ? 0x3ff0000000000000ul : 0x3feffffffffffffful;
    }

    // |x| >= 1024 cannot be reduced by this path and is decided by range.
    // exp(1024) overflows binary64 and exp(-1024) is below half the smallest
    // subnormal, so both results follow from the rounding mode alone.
    if (exponentField >= 1033u) {
        flags |= soft_flag_inexact;
        if (!sign) {
            flags |= soft_flag_overflow;
            return soft_overflow_result(false, roundingMode);
        }
        flags |= soft_flag_underflow;
        return roundingMode == soft_round_max ? 1ul : 0ul;
    }

    return soft_wide_to_f64_status(
        soft_exp64_wide(a), roundingMode, flags, certified
    );
}

// Bit 5 is not an IEEE exception. It is a VF64 M9 extension that reports a
// result whose rounding this implementation could not prove for that argument,
// so that a caller using the flags API instead of the certification argument
// still cannot mistake an unproven result for a proven one.
constant uint soft_flag_uncertified = 32;

inline ulong soft_exp64_status(ulong a, uint roundingMode, thread uint &flags) {
    bool certified = true;
    ulong result = soft_exp64_certified(a, roundingMode, flags, certified);
    if (!certified) flags |= soft_flag_uncertified;
    return result;
}

// The convenience forms discard both the exception flags and the certificate,
// matching the M2 rule for its own flag-free wrappers: valid only where the
// caller's contract observes neither.
inline ulong soft_exp64_mode(ulong a, uint roundingMode) {
    uint ignoredFlags = 0u;
    return soft_exp64_status(a, roundingMode, ignoredFlags);
}

inline ulong soft_exp64(ulong a) {
    return soft_exp64_mode(a, soft_round_near_even);
}
