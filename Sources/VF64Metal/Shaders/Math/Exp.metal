    soft_wide{0x8671cb6dbfc294a2ul, 0x86485bf99c763abbul, -69, false},  // 1/22!
    soft_wide{0xbb0da098b1c0cecbul, 0xdc3826ebfb13cc26ul, -74, false},  // 1/23!
    soft_wide{0xf96780cb97abbe65ul, 0x25a033e54ec51033ul, -79, false},  // 1/24!
