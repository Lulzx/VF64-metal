// M9 correctly rounded binary64 exponential.
//
// exp(x) = 2^k * exp(r) with k = round(x / ln2) and r = x - k*ln2.
//
// The reduction is a Cody-Waite split: ln2_hi carries 40 significant bits, so
// k*ln2_hi is exact in a 128-bit significand for every reachable |k| < 2^11,
// and x - k*ln2_hi is exact as well because it is a multiple of 2^-54 below
// 2^11. Only the k*ln2_lo term is inexact, contributing an absolute error
// below 2^-155 to r, which is a relative error of the same size in the result.
//
// exp(r) is a 30-term Taylor sum evaluated by Horner in the wide format. The
// truncated tail is below 2^-160 at |r| <= ln2/2, and the 60 truncating wide
// operations contribute below 2^-121, so the evaluation error stays under
// 2^-120. Scaling by 2^k is exact, being an exponent adjustment.
//
// The result is certified per call: soft_wide_to_f64_status reports whether
// the wide value is farther from the deciding rounding boundary than 2^-116
// relative, which bounds the evaluation error with margin to spare. A
// certified result is correctly rounded. An uncertified result is reported,
// never silently returned as if it were proven. See
// docs/milestones/M9-transcendentals.md for the proof-obligation states.

// Generated by tools/m9/generate-exp-constants.py. Do not edit by hand.
// ln2 split: 40 leading bits in the high term.
constant soft_wide SOFT_EXP_INV_LN2 = soft_wide{0xb8aa3b295c17f0bbul, 0xbe87fed0691d3e88ul, 1, false};
constant soft_wide SOFT_EXP_LN2_HI = soft_wide{0xb17217f7d1000000ul, 0x0000000000000000ul, 0, false};
constant soft_wide SOFT_EXP_LN2_LO = soft_wide{0xcf79abc9e3b39803ul, 0xf2f6af40f3432672ul, -40, false};

constant int SOFT_EXP_TERMS = 30;
constant soft_wide SOFT_EXP_RECIPROCAL_FACTORIAL[31] = {
    soft_wide{0x8000000000000000ul, 0x0000000000000000ul, 1, false},  // 1/0!
    soft_wide{0x8000000000000000ul, 0x0000000000000000ul, 1, false},  // 1/1!
    soft_wide{0x8000000000000000ul, 0x0000000000000000ul, 0, false},  // 1/2!
    soft_wide{0xaaaaaaaaaaaaaaaaul, 0xaaaaaaaaaaaaaaaaul, -2, false},  // 1/3!
    soft_wide{0xaaaaaaaaaaaaaaaaul, 0xaaaaaaaaaaaaaaaaul, -4, false},  // 1/4!
    soft_wide{0x8888888888888888ul, 0x8888888888888888ul, -6, false},  // 1/5!
    soft_wide{0xb60b60b60b60b60bul, 0x60b60b60b60b60b6ul, -9, false},  // 1/6!
    soft_wide{0xd00d00d00d00d00dul, 0x00d00d00d00d00d0ul, -12, false},  // 1/7!
    soft_wide{0xd00d00d00d00d00dul, 0x00d00d00d00d00d0ul, -15, false},  // 1/8!
    soft_wide{0xb8ef1d2ab6399c7dul, 0x560e4472800b8ef1ul, -18, false},  // 1/9!
    soft_wide{0x93f27dbbc4fae397ul, 0x780b69f5333c725bul, -21, false},  // 1/10!
    soft_wide{0xd7322b3faa271c7ful, 0x3a3f25c1bee38f10ul, -25, false},  // 1/11!
    soft_wide{0x8f76c77fc6c4bdaaul, 0x26d4c3d67f425f60ul, -28, false},  // 1/12!
    soft_wide{0xb092309d43684be5ul, 0x1c198e91d7b4269dul, -32, false},  // 1/13!
    soft_wide{0xc9cba54603e4e905ul, 0xd6f8a2efd1f27546ul, -36, false},  // 1/14!
    soft_wide{0xd73f9f399dc0f88eul, 0xc32b58774657f48ful, -40, false},  // 1/15!
    soft_wide{0xd73f9f399dc0f88eul, 0xc32b58774657f48ful, -44, false},  // 1/16!
    soft_wide{0xca963b81856a5359ul, 0x3028cbbb8d7ff53bul, -48, false},  // 1/17!
    soft_wide{0xb413c31dcbecbbddul, 0x8024435161554bc3ul, -52, false},  // 1/18!
    soft_wide{0x97a4da340a0ab926ul, 0x50f61dbdcb3a5abful, -56, false},  // 1/19!
