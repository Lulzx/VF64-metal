// truncated atanh tail: < 2^-199.5 relative

// log2(m) for binary64-derived m in [sqrt2/2, sqrt2), within 2^-186.
inline soft_wide3 soft_pow_log2_reduced(soft_wide m) {
    soft_wide3 mw = soft_wide3_from_wide(m);
    soft_wide3 one = soft_wide3_one();
    soft_wide3 s = soft_wide3_div(soft_wide3_sub(mw, one), soft_wide3_add(mw, one));
    soft_wide3 z = soft_wide3_mul(s, s);
    soft_wide3 accumulator = SOFT_POW_ATANH_COEFFICIENT[SOFT_POW_LOG_TERMS];
    for (int term = SOFT_POW_LOG_TERMS - 1; term >= 0; --term) {
        accumulator = soft_wide3_add(
            SOFT_POW_ATANH_COEFFICIENT[term], soft_wide3_mul(z, accumulator)
        );
    }
    return soft_wide3_mul(soft_wide3_mul(s, accumulator), SOFT_POW_TWO_OVER_LN2);
}

// Exact integer square root of v < 2^63, or false if v is not a square.
inline bool soft_pow_exact_sqrt(ulong v, thread ulong &root) {
    ulong r = ulong(sqrt(float(v)));
    for (int step = 0; step < 64 && r * r > v; ++step) --r;
    for (int step = 0; step < 64 && (r + 1ul) * (r + 1ul) <= v; ++step) ++r;
    root = r;
    return r * r == v;
}

// A^n into a 128-bit integer, or false on overflow.
inline bool soft_pow_integer_power(ulong base, uint n, thread soft_u128 &power) {
    soft_u128 result = soft_u128{0ul, 1ul};
    for (uint i = 0; i < n; ++i) {
        // result * base, with base < 2^53: overflow when the high part grows
        // past 2^128.
        ulong low = result.lo * base;
        ulong carry = mulhi(result.lo, base);
        ulong highLow = result.hi * base;
        if (mulhi(result.hi, base) != 0ul) return false;
        ulong high = highLow + carry;
        if (high < highLow) return false;
        result = soft_u128{high, low};
    }
    power = result;
    return true;
}

// Rounds |x|^y exactly when it is rational and dyadic: x a perfect 2^k-th
// power and y = n / 2^k with n > 0, or x a power of two with E y an integer.
// Returns false when x^y is irrational or not dyadic.
inline bool soft_pow_exact(
    ulong xMagnitude, ulong yBits, bool negative, uint roundingMode,
    thread uint &flags, thread ulong &result
) {
    soft_normalized xn = soft_normalize_operand(
        uint(xMagnitude >> 52), xMagnitude & 0x000ffffffffffffful
    );
    uint xZeros = uint(ctz(xn.significand));
    ulong oddX = xn.significand >> xZeros;
    int powerX = xn.exponent - 1075 + int(xZeros);

    ulong yMagnitude = yBits & 0x7ffffffffffffffful;
    bool yNegative = (yBits >> 63) != 0ul;
    soft_normalized yn = soft_normalize_operand(
        uint(yMagnitude >> 52), yMagnitude & 0x000ffffffffffffful
    );
    uint yZeros = uint(ctz(yn.significand));
    ulong oddY = yn.significand >> yZeros;
    int powerY = yn.exponent - 1075 + int(yZeros);  // y = oddY 2^powerY

    if (oddX == 1ul) {
        // |x|^y = 2^(E y): dyadic exactly when E y is an integer. |E y| at or
        // beyond 4096 overflows or underflows, and is saturated there.
        if (powerX == 0) return false;  // |x| = 1 is decided earlier
        long scaled = long(powerX);
        if (powerY < 0) {
            uint k = uint(-powerY);
            if (k > 11u || (powerX % (1 << k)) != 0) return false;
            scaled /= long(1 << k);
        }
        long exponent = 4096;
        if (oddY < 4096ul && powerY < 13) {
            exponent = min(scaled * long(oddY << uint(max(powerY, 0))), 4096l);
            exponent = max(exponent, -4096l);
        } else if (scaled < 0) {
            exponent = -4096;
        }
        if (yNegative) exponent = -exponent;
        soft_wide value = soft_wide_scale2(soft_wide_one(), int(exponent));
        value.sign = negative;
        result = soft_wide_exact_to_f64_status(value, roundingMode, flags);
        return true;
    }
    if (yNegative) return false;  // 1 / X^n with X odd > 1 is not dyadic
    uint k = powerY < 0 ? uint(-powerY) : 0u;
    if (k > 5u) return false;
    ulong root = oddX;
    for (uint step = 0; step < k; ++step) {
        if (!soft_pow_exact_sqrt(root, root)) return false;
    }
    if (k > 0u && (powerX % (1 << k)) != 0) return false;
    int rootPower = powerX / (1 << k);
    if (powerY > 7) return false;  // n >= 2^7: A^n exceeds 128 bits for A >= 3
    ulong n = oddY << uint(max(powerY, 0));
    if (n > 128ul) return false;
    soft_u128 power;
    if (!soft_pow_integer_power(root, uint(n), power)) return false;
    soft_wide value = soft_wide_from_root(power, false, rootPower * int(n), negative);
    result = soft_wide_exact_to_f64_status(value, roundingMode, flags);
    return true;
}

// Integer classification of a finite y: 0 not an integer, 1 even, 2 odd.
inline uint soft_pow_integer_kind(ulong y) {
    uint exponentField = uint((y >> 52) & 0x7fful);
    ulong fraction = y & 0x000ffffffffffffful;
    if ((y & 0x7ffffffffffffffful) == 0ul) return 1u;
    if (exponentField < 1023u) return 0u;
    if (exponentField > 1075u) return 1u;
    uint fractionBits = 1075u - exponentField;  // bits below the units bit
    ulong significand = fraction | (1ul << 52);
    if (fractionBits == 0u) return (significand & 1ul) != 0ul ? 2u : 1u;
    if ((significand & ((1ul << fractionBits) - 1ul)) != 0ul) return 0u;
    return ((significand >> fractionBits) & 1ul) != 0ul ? 2u : 1u;
}

// Special values follow IEEE 754-2019 9.2.1; signaling NaNs raise invalid
// and propagate as in M2, including pow(sNaN, 0) and pow(1, sNaN).
inline ulong soft_pow64_certified(
    ulong x, ulong y, uint roundingMode, thread uint &flags, thread bool &certified
) {
    certified = true;
    if (soft_is_signaling_nan(x) || soft_is_signaling_nan(y)) {
        flags |= soft_flag_invalid;
        return soft_propagate_nan(x, y);
    }
    ulong xMagnitude = x & 0x7ffffffffffffffful;
    ulong yMagnitude = y & 0x7ffffffffffffffful;
    bool xNegative = (x >> 63) != 0ul;
    bool yNegative = (y >> 63) != 0ul;
    const ulong one = 0x3ff0000000000000ul;
    const ulong infinity = 0x7ff0000000000000ul;
    if (yMagnitude == 0ul || x == one) return one;
    if (soft_is_nan(x) || soft_is_nan(y)) return soft_propagate_nan(x, y);

    bool yInfinite = yMagnitude == infinity;
    uint kind = yInfinite ? 1u : soft_pow_integer_kind(y);
    bool oddInteger = kind == 2u;
    if (yInfinite) {
        if (xMagnitude == one) return one;  // pow(-1, +-inf)
        bool above = xMagnitude > one;      // |x| > 1, including infinities
        return (above != yNegative) ? infinity : 0ul;
    }
    if (xMagnitude == 0ul) {
        ulong signBit = (xNegative && oddInteger) ? 0x8000000000000000ul : 0ul;
        if (yNegative) {
            flags |= soft_flag_infinite;
            return signBit | infinity;
        }
        return signBit;
    }
    if (xMagnitude == infinity) {
        ulong signBit = (xNegative && oddInteger) ? 0x8000000000000000ul : 0ul;
        return signBit | (yNegative ? 0ul : infinity);
    }
    if (xNegative && kind == 0u) {
        flags |= soft_flag_invalid;
        return 0x7ff8000000000000ul;
    }
    bool negative = xNegative && oddInteger;
    if (xMagnitude == one) return negative ? (one | 0x8000000000000000ul) : one;

    ulong exact;
    if (soft_pow_exact(xMagnitude, y, negative, roundingMode, flags, exact)) {
        return exact;
    }

    int e;
    soft_wide m = soft_log_split(soft_wide_from_f64(xMagnitude), e);
    soft_wide3 yw = soft_wide3_from_f64(y);
    soft_wide3 z = soft_wide3_add(
        soft_wide3_mul(yw, soft_wide3_from_int(e)),
        soft_wide3_mul(yw, soft_pow_log2_reduced(m))
    );
    // |z| >= 2048 overflows or lies far below half the smallest subnormal.
    // (1.5 + 2^-65) 2^(+-4096) stands in for the result: like it, it lies
    // far from every binary64 value and midpoint, so the rounding is
    // certified in every mode.
    if (z.exponent > 11) {
        soft_wide extreme = soft_wide{
            3ul << 62, 1ul << 63, z.sign ? -4096 : 4096, negative
        };
        return soft_wide_to_f64_status(extreme, roundingMode, flags, certified);
    }
    // |z| < 2^-60: 2^z lies within 2^-60 of 1 and is never exactly 1, so the
    // result is 1 or its neighbour, by the exp argument.
    if (z.exponent < -59) {
        ulong base = negative ? (one | 0x8000000000000000ul) : one;
        return soft_round_beside(base, z.sign == negative, roundingMode, flags);
    }
    int k = soft_wide3_round_to_int(z);
    soft_wide r = soft_wide3_to_wide(soft_wide3_sub(z, soft_wide3_from_int(k)));
    soft_wide value = soft_wide_scale2(soft_exp_poly(soft_wide_mul(r, SOFT_LOG_LN2)), k);
    value.sign = negative;
    return soft_wide_to_f64_status(value, roundingMode, flags, certified);
}
