constant int SOFT_TRIG_SIN_TERMS = 15;
constant int SOFT_TRIG_COS_TERMS = 16;
// truncated series tails at |r| <= pi/4: sine < 2^-133.9 relative,
// cosine < 2^-139.1 relative
// min |x - k pi/2| over binary64 x >= pi/4: > 2^-60.9
// (x 2/pi within 2^-61.5 of an integer, at exponent 797)

// Adds `value` into limb `index` of a little-endian 384-bit integer.
inline void soft_trig_accumulate(thread ulong *limbs, uint index, ulong value) {
    for (; index < 6u && value != 0ul; ++index) {
        ulong sum = limbs[index] + value;
        value = ulong(sum < value);
        limbs[index] = sum;
    }
}

// Shifts a little-endian 384-bit integer left by `distance` bits, discarding
// the bits that leave the top, never shifting a 64-bit limb by 64.
inline void soft_trig_shift_left384(thread ulong *limbs, uint distance) {
    uint whole = distance / 64u;
    uint bits = distance % 64u;
    for (int index = 5; index >= 0; --index) {
        int source = index - int(whole);
        ulong value = 0ul;
        if (source >= 0) {
            value = limbs[source] << bits;
            if (bits != 0u && source >= 1) value |= limbs[source - 1] >> (64u - bits);
        }
        limbs[index] = value;
    }
}

// Reduces a finite positive binary64 |x| > pi/4 to r = x - q pi/2, returning
// r and q mod 4.
inline soft_wide soft_trig_reduce_large(ulong magnitude, thread uint &quadrant) {
    soft_normalized x = soft_normalize_operand(
        uint(magnitude >> 52), magnitude & 0x000ffffffffffffful
    );
    int E = x.exponent - 1075;  // |x| = M 2^E
    int k0 = E >= 2 ? (E - 2) / 64 : 0;
    int d = E - 64 * (k0 + 1);  // the product's units bit is bit 256 - d

    ulong limbs[6] = {0ul, 0ul, 0ul, 0ul, 0ul, 0ul};
    for (uint j = 0u; j < 5u; ++j) {
        ulong word = SOFT_TRIG_TWO_OVER_PI[k0 + int(j)];
        soft_trig_accumulate(limbs, 4u - j, x.significand * word);
        soft_trig_accumulate(limbs, 5u - j, mulhi(x.significand, word));
    }

    uint units = uint(256 - d);
    uint q = 0u;
    for (uint bit = 0u; bit < 2u; ++bit) {
        uint position = units + bit;
        q |= uint((limbs[position / 64u] >> (position % 64u)) & 1ul) << bit;
    }

    // Move the fraction to the top: bit 383 now has weight 1/2.
    soft_trig_shift_left384(limbs, 384u - units);
    bool negative = (limbs[5] >> 63) != 0ul;
    if (negative) {  // f >= 1/2: take q + 1 and f - 1
        q += 1u;
        ulong carry = 1ul;
        for (uint index = 0u; index < 6u; ++index) {
            ulong value = ~limbs[index] + carry;
            carry = ulong(carry != 0ul && value == 0ul);
            limbs[index] = value;
        }
    }
    quadrant = q & 3u;

    uint leading = 0u;
    for (int index = 5; index >= 0 && limbs[index] == 0ul; --index) leading += 64u;
    if (leading < 384u) leading += uint(clz(limbs[5 - int(leading / 64u)]));
    soft_trig_shift_left384(limbs, leading);
    soft_wide f = soft_wide{limbs[5], limbs[4], -int(leading), negative};
    return soft_wide_mul(f, SOFT_ATAN_PI_2);
}

// pi/4 rounded down to binary64; arguments at or below it are not reduced.
constant ulong soft_trig_pi_4_bits = 0x3fe921fb54442d18ul;

inline soft_wide soft_trig_reduce(ulong magnitude, thread uint &quadrant) {
    if (magnitude <= soft_trig_pi_4_bits) {
        quadrant = 0u;
        return soft_wide_from_f64(magnitude);
    }
    return soft_trig_reduce_large(magnitude, quadrant);
}

inline soft_wide soft_trig_sin(soft_wide r, soft_wide z) {
    soft_wide accumulator = SOFT_TRIG_RECIPROCAL_FACTORIAL[2 * SOFT_TRIG_SIN_TERMS + 1];
    for (int term = SOFT_TRIG_SIN_TERMS - 1; term >= 0; --term) {
        accumulator = soft_wide_sub(
            SOFT_TRIG_RECIPROCAL_FACTORIAL[2 * term + 1], soft_wide_mul(z, accumulator)
        );
    }
    return soft_wide_mul(r, accumulator);
}

inline soft_wide soft_trig_cos(soft_wide z) {
    soft_wide accumulator = SOFT_TRIG_RECIPROCAL_FACTORIAL[2 * SOFT_TRIG_COS_TERMS];
    for (int term = SOFT_TRIG_COS_TERMS - 1; term >= 0; --term) {
        accumulator = soft_wide_sub(
            SOFT_TRIG_RECIPROCAL_FACTORIAL[2 * term], soft_wide_mul(z, accumulator)
        );
    }
    return accumulator;
}

// |x| < 2^-27, nonzero, as for atan.
constant uint soft_trig_tiny_exponent_field = 996u;

// A reduced |r| < 2^-27 on a cosine branch: cos r = 1 - r^2/2 + ... lies
// strictly between 1 - 2^-55 and 1, so the result is +-1 or its neighbour
// toward zero. The hardest arguments reach |r| near 2^-61, where cos r is
// within 2^-116 of 1 and could never be certified. The test is on the
// computed r, whose relative error of 2^-125.4 leaves the true r^2/2 below
// 2^-55 as well.
inline bool soft_trig_near_one(soft_wide r) {
    return r.exponent <= -27;
}

inline ulong soft_trig_round_one(bool negative, uint roundingMode, thread uint &flags) {
    ulong one = negative ? 0xbff0000000000000ul : 0x3ff0000000000000ul;
    return soft_round_beside(one, negative, roundingMode, flags);
}

// NaNs and infinities, shared by sin, cos, and tan. Returns true when decided.
inline bool soft_trig_special(ulong a, thread ulong &result, thread uint &flags) {
    if (soft_is_nan(a)) {
        if (soft_is_signaling_nan(a)) flags |= soft_flag_invalid;
        result = a | 0x0008000000000000ul;
        return true;
    }
    if ((a & 0x7ffffffffffffffful) == 0x7ff0000000000000ul) {
        flags |= soft_flag_invalid;
        result = 0x7ff8000000000000ul;
        return true;
    }
    return false;
}

inline ulong soft_sin64_certified(
    ulong a, uint roundingMode, thread uint &flags, thread bool &certified
) {
    certified = true;
    ulong special;
    if (soft_trig_special(a, special, flags)) return special;
    ulong magnitude = a & 0x7ffffffffffffffful;
    bool sign = (a >> 63) != 0ul;
    if (magnitude == 0ul) return a;
    if (uint(magnitude >> 52) < soft_trig_tiny_exponent_field) {
        return soft_round_beside(a, sign, roundingMode, flags);
    }
    uint quadrant;
    soft_wide r = soft_trig_reduce(magnitude, quadrant);
    bool negative = ((quadrant & 2u) != 0u) != sign;
    if ((quadrant & 1u) != 0u && soft_trig_near_one(r)) {
        return soft_trig_round_one(negative, roundingMode, flags);
    }
    soft_wide z = soft_wide_mul(r, r);
    soft_wide value = (quadrant & 1u) != 0u ? soft_trig_cos(z) : soft_trig_sin(r, z);
    return soft_wide_to_f64_status(
        soft_wide_negate_if(value, negative), roundingMode, flags, certified
    );
}

inline ulong soft_cos64_certified(
    ulong a, uint roundingMode, thread uint &flags, thread bool &certified
) {
    certified = true;
    ulong special;
    if (soft_trig_special(a, special, flags)) return special;
    ulong magnitude = a & 0x7ffffffffffffffful;
    if (magnitude == 0ul) return 0x3ff0000000000000ul;
    if (uint(magnitude >> 52) < soft_trig_tiny_exponent_field) {
        return soft_round_beside(0x3ff0000000000000ul, false, roundingMode, flags);
    }
    uint quadrant;
    soft_wide r = soft_trig_reduce(magnitude, quadrant);
    // cos(r + q pi/2) is cos r, -sin r, -cos r, sin r for q = 0, 1, 2, 3.
    bool negative = quadrant == 1u || quadrant == 2u;
    if ((quadrant & 1u) == 0u && soft_trig_near_one(r)) {
        return soft_trig_round_one(negative, roundingMode, flags);
    }
    soft_wide z = soft_wide_mul(r, r);
    soft_wide value = (quadrant & 1u) != 0u ? soft_trig_sin(r, z) : soft_trig_cos(z);
    return soft_wide_to_f64_status(
        soft_wide_negate_if(value, negative), roundingMode, flags, certified
    );
}

inline ulong soft_tan64_certified(
    ulong a, uint roundingMode, thread uint &flags, thread bool &certified
) {
    certified = true;
    ulong special;
    if (soft_trig_special(a, special, flags)) return special;
    ulong magnitude = a & 0x7ffffffffffffffful;
    bool sign = (a >> 63) != 0ul;
    if (magnitude == 0ul) return a;
    if (uint(magnitude >> 52) < soft_trig_tiny_exponent_field) {
        return soft_round_beside(a, !sign, roundingMode, flags);
    }
    uint quadrant;
    soft_wide r = soft_trig_reduce(magnitude, quadrant);
    soft_wide z = soft_wide_mul(r, r);
    soft_wide s = soft_trig_sin(r, z);
    soft_wide c = soft_trig_cos(z);
    // tan(r + q pi/2) is tan r for even q and -1/tan r for odd q.
    soft_wide value = (quadrant & 1u) != 0u
        ? soft_wide_negate_if(soft_wide_div(c, s), true)
        : soft_wide_div(s, c);
    return soft_wide_to_f64_status(
        soft_wide_negate_if(value, sign), roundingMode, flags, certified
    );
}
